<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E1A">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0A0E1A"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingTop="48dp">

            <!-- Header row: welcome + logout -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/splash_logo"
                        android:contentDescription="CareLink"
                        android:layout_marginBottom="2dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CareLink"
                        android:textSize="14sp"
                        android:textColor="#7C6FFF"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"/>

                    <TextView
                        android:id="@+id/tvWelcomeName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hello 👋"
                        android:textSize="26sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btnLogout"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Sign Out"
                    android:textSize="12sp"
                    android:textColor="#9CA3AF"
                    android:backgroundTint="#111827"
                    app:cornerRadius="10dp"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="What do you need today?"
                android:textSize="14sp"
                android:textColor="#6B7280"
                android:layout_marginBottom="28dp"/>

            <!-- Communication Aid -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardCommunication"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginBottom="14dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#1A1633">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:text="💬"
                        android:textSize="28sp"
                        android:gravity="center"
                        android:background="#2A2050"
                        android:layout_marginEnd="16dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Communication Aid"
                            android:textSize="18sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Voice and text conversion"
                            android:textSize="13sp"
                            android:textColor="#9CA3AF"
                            android:layout_marginTop="3dp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="22sp"
                        android:textColor="#7C6FFF"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Smart Reminders -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardReminders"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginBottom="14dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#0D2B1E">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:text="⏰"
                        android:textSize="28sp"
                        android:gravity="center"
                        android:background="#0A2015"
                        android:layout_marginEnd="16dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Smart Reminders"
                            android:textSize="18sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tasks and medication alerts"
                            android:textSize="13sp"
                            android:textColor="#9CA3AF"
                            android:layout_marginTop="3dp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="22sp"
                        android:textColor="#10B981"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Emergency SOS -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardEmergencySOS"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginBottom="14dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#2B0D0D">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:text="🚨"
                        android:textSize="28sp"
                        android:gravity="center"
                        android:background="#200A0A"
                        android:layout_marginEnd="16dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Emergency SOS"
                            android:textSize="18sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quick help in emergencies"
                            android:textSize="13sp"
                            android:textColor="#9CA3AF"
                            android:layout_marginTop="3dp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="22sp"
                        android:textColor="#EF4444"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Settings -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSettings"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginBottom="14dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#111827">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:text="⚙️"
                        android:textSize="28sp"
                        android:gravity="center"
                        android:background="#0A0E1A"
                        android:layout_marginEnd="16dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Settings"
                            android:textSize="18sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Theme, caregiver link and more"
                            android:textSize="13sp"
                            android:textColor="#9CA3AF"
                            android:layout_marginTop="3dp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="22sp"
                        android:textColor="#6B7280"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Caregiver shortcut (hidden by default — shown only if cardCaregiver needed) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardCaregiver"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginBottom="14dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#1A1633">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:text="👨\u200d⚕️"
                        android:textSize="28sp"
                        android:gravity="center"
                        android:background="#120E2A"
                        android:layout_marginEnd="16dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Caregiver Dashboard"
                            android:textSize="18sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Monitor linked user"
                            android:textSize="13sp"
                            android:textColor="#9CA3AF"
                            android:layout_marginTop="3dp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="22sp"
                        android:textColor="#7C6FFF"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Safety Assistant ★ NEW -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSafety"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginBottom="14dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#1A1220">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:text="🔍"
                        android:textSize="28sp"
                        android:gravity="center"
                        android:background="#120E1A"
                        android:layout_marginEnd="16dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Safety Assistant"
                            android:textSize="18sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AI object detection + voice alerts"
                            android:textSize="13sp"
                            android:textColor="#9CA3AF"
                            android:layout_marginTop="3dp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="22sp"
                        android:textColor="#A855F7"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Gesture Control ★ NEW -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardGesture"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginBottom="14dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#1A0D2B">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:text="✋"
                        android:textSize="28sp"
                        android:gravity="center"
                        android:background="#12081A"
                        android:layout_marginEnd="16dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gesture Control"
                            android:textSize="18sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Control app with hand gestures"
                            android:textSize="13sp"
                            android:textColor="#9CA3AF"
                            android:layout_marginTop="3dp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="22sp"
                        android:textColor="#A855F7"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Care Chatbot ★ NEW -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardChatbot"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginBottom="14dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#0D1F2B">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:text="🤖"
                        android:textSize="28sp"
                        android:gravity="center"
                        android:background="#081520"
                        android:layout_marginEnd="16dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Care Assistant"
                            android:textSize="18sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Smart chatbot · voice · actions"
                            android:textSize="13sp"
                            android:textColor="#9CA3AF"
                            android:layout_marginTop="3dp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="22sp"
                        android:textColor="#0EA5E9"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Quick Help -->
            <Button
                android:id="@+id/btnQuickHelp"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="❓  Quick Help"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#111827"
                android:layout_marginTop="4dp"
                app:cornerRadius="14dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- Voice status label -->
    <TextView
        android:id="@+id/tvVoiceStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="88dp"
        android:background="#CC000000"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone"/>

    <!-- Voice Navigation FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabVoiceNav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="20dp"
        android:contentDescription="Voice Navigation"
        app:backgroundTint="#7C6FFF"
        app:srcCompat="@android:drawable/ic_btn_speak_now"
        app:fabSize="normal"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>