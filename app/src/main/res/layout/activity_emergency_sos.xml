<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <!-- ── Header ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚨  Emergency SOS"
            android:textSize="28sp"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="One tap alerts your contacts instantly"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            android:layout_gravity="center"
            android:layout_marginBottom="32dp"/>

        <!-- ── SOS Button ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="200dp"
            android:layout_height="200dp"
            app:cardCornerRadius="100dp"
            app:cardElevation="16dp"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#1F0A0A">

            <FrameLayout
                android:id="@+id/btnSOS"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center">

                    <!--
                        ★ FIX: Added android:id="@+id/tvSOSLabel" here.
                           Previously this TextView had NO id, so
                           R.id.tvSOSLabel did not exist → compile error.
                    -->
                    <TextView
                        android:id="@+id/tvSOSLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SOS"
                        android:textSize="52sp"
                        android:textColor="#EF4444"
                        android:textStyle="bold"/>

                    <!--
                        ★ Also added android:id="@+id/tvSOSSubLabel" to the
                           sub-label so Java can update "PRESS" → "TAP TO STOP"
                    -->
                    <TextView
                        android:id="@+id/tvSOSSubLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PRESS"
                        android:textSize="14sp"
                        android:textColor="#9C4040"
                        android:letterSpacing="0.12"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── Status text ── -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Press SOS button in emergency"
            android:textSize="15sp"
            android:textColor="?attr/colorOnSurface"
            android:gravity="center"
            android:textAlignment="center"
            android:layout_marginBottom="24dp"/>

        <!-- ── STOP button (hidden until SOS fires) ── -->
        <Button
            android:id="@+id/btnStopAlarm"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🛑  STOP ALL ALERTS"
            android:textSize="16sp"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            android:backgroundTint="?attr/colorSurfaceVariant"
            android:layout_marginBottom="24dp"
            android:visibility="gone"
            app:cornerRadius="14dp"/>

        <!-- ── Emergency Contacts ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="?attr/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📞  Emergency Contacts"
                    android:textSize="17sp"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Include country code e.g. +91XXXXXXXXXX"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="16dp"/>

                <!-- Contact 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <EditText
                        android:id="@+id/etContact1"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:hint="+91XXXXXXXXXX"
                        android:inputType="phone"
                        android:padding="12dp"
                        android:background="?android:attr/colorBackground"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="?attr/colorOnSurface"
                        android:layout_marginEnd="8dp"/>

                    <EditText
                        android:id="@+id/etName1"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:hint="Name"
                        android:inputType="textPersonName"
                        android:padding="12dp"
                        android:background="?android:attr/colorBackground"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="?attr/colorOnSurface"/>
                </LinearLayout>

                <!-- Contact 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <EditText
                        android:id="@+id/etContact2"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:hint="+91XXXXXXXXXX"
                        android:inputType="phone"
                        android:padding="12dp"
                        android:background="?android:attr/colorBackground"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="?attr/colorOnSurface"
                        android:layout_marginEnd="8dp"/>

                    <EditText
                        android:id="@+id/etName2"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:hint="Name"
                        android:inputType="textPersonName"
                        android:padding="12dp"
                        android:background="?android:attr/colorBackground"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="?attr/colorOnSurface"/>
                </LinearLayout>

                <!-- Contact 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <EditText
                        android:id="@+id/etContact3"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:hint="+91XXXXXXXXXX"
                        android:inputType="phone"
                        android:padding="12dp"
                        android:background="?android:attr/colorBackground"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="?attr/colorOnSurface"
                        android:layout_marginEnd="8dp"/>

                    <EditText
                        android:id="@+id/etName3"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:hint="Name"
                        android:inputType="textPersonName"
                        android:padding="12dp"
                        android:background="?android:attr/colorBackground"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="?attr/colorOnSurface"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btnSaveContacts"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="💾  Save Contacts"
                    android:textSize="15sp"
                    android:textColor="?attr/colorOnSurface"
                    android:backgroundTint="#10B981"
                    app:cornerRadius="12dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── SOS Features ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙️  SOS Features"
                    android:textSize="17sp"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <!-- Live Location toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📍  Send Live Location"
                        android:textSize="15sp"
                        android:textColor="?attr/colorOnSurface"/>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"/>
                </LinearLayout>

                <!-- Alarm toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🔊  Play Loud Alarm"
                        android:textSize="15sp"
                        android:textColor="?attr/colorOnSurface"/>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchAlarm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"/>
                </LinearLayout>

                <!-- Auto Call toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📱  Auto Call Contact 1"
                        android:textSize="15sp"
                        android:textColor="?attr/colorOnSurface"/>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchAutoCall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"/>
                </LinearLayout>

                <!-- Flashlight toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="💡  Flash Torch (SOS pattern)"
                        android:textSize="15sp"
                        android:textColor="?attr/colorOnSurface"/>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchFlashlight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"/>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>