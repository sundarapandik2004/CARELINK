<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingTop="48dp">

        <!-- Page title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="26sp"
            android:textColor="?attr/colorOnBackground"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <!-- ══ THEME PICKER ══════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/colorSurface"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="APP THEME"
                android:textSize="11sp"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Changing theme restarts the app"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurface"
                android:alpha="0.5"
                android:layout_marginBottom="14dp"/>

            <!-- Theme buttons are built dynamically in Java -->
            <LinearLayout
                android:id="@+id/themeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </LinearLayout>

        <!-- ══ CAREGIVER LINK ════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/caregiverLinkSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/colorSurface"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CAREGIVER LINK"
                android:textSize="11sp"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tvCurrentCaregiverStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Checking..."
                android:textSize="14sp"
                android:textColor="#10B981"
                android:layout_marginBottom="14dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter caregiver's code:"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurface"
                android:alpha="0.6"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etNewCaregiverCode"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Paste caregiver's code here"
                android:textSize="14sp"
                android:padding="12dp"
                android:background="?android:attr/colorBackground"
                android:textColor="?attr/colorOnBackground"
                android:textColorHint="#4B5563"
                android:inputType="textNoSuggestions"
                android:fontFamily="monospace"
                android:layout_marginBottom="10dp"/>

            <ProgressBar
                android:id="@+id/pbLinking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_gravity="center"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnLinkCaregiver"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Link to Caregiver"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="?attr/colorPrimary"
                android:layout_marginBottom="8dp"
                app:cornerRadius="10dp"/>

            <Button
                android:id="@+id/btnRemoveCaregiver"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Remove Caregiver Link"
                android:textSize="13sp"
                android:textColor="#EF4444"
                android:backgroundTint="?android:attr/colorBackground"
                android:visibility="gone"
                app:cornerRadius="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="How: Caregiver opens dashboard → taps Copy Code → sends it to you → paste here"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurface"
                android:alpha="0.4"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- ══ DISPLAY ═══════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/colorSurface"
            android:padding="18dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DISPLAY"
                android:textSize="11sp"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="14dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Font Size"
                android:textSize="15sp"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <SeekBar
                    android:id="@+id/sbFontSize"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="30"
                    android:progress="16"/>

                <TextView
                    android:id="@+id/tvFontSizeValue"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="16sp"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.6"
                    android:gravity="end"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Speech Rate"
                android:textSize="15sp"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <SeekBar
                    android:id="@+id/sbSpeechRate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="20"
                    android:progress="8"/>

                <TextView
                    android:id="@+id/tvSpeechRateValue"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="0.8x"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.6"
                    android:gravity="end"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ══ ACCESSIBILITY ══════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/colorSurface"
            android:padding="18dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACCESSIBILITY"
                android:textSize="11sp"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="14dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Voice Feedback"
                    android:textSize="15sp"
                    android:textColor="?attr/colorOnSurface"/>

                <Switch
                    android:id="@+id/swVoiceFeedback"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="High Contrast Mode"
                    android:textSize="15sp"
                    android:textColor="?attr/colorOnSurface"/>

                <Switch
                    android:id="@+id/swHighContrast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>