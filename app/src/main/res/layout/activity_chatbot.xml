<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080812">

    <!-- ── HEADER ──────────────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#12122A"
        android:elevation="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <!-- Back button -->
        <ImageButton
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#AAAACC"
            android:onClick="finish"
            android:contentDescription="Back"/>

        <!-- Bot avatar circle -->
        <TextView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="🤖"
            android:textSize="22sp"
            android:background="#1E1E40"
            android:padding="4dp"/>

        <!-- Name + status -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Care Assistant"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvBotStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟢 Online · Always here for you"
                android:textColor="#10B981"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/tvContactBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F59E0B"
                android:textSize="10sp"
                android:visibility="gone"/>

        </LinearLayout>

        <!-- Voice mute toggle -->
        <ImageButton
            android:id="@+id/btnVoiceMute"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_lock_silent_mode_off"
            android:tint="#7C6FFF"
            android:contentDescription="Toggle voice"/>

        <!-- SOS shortcut -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="#C0392B"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="🚨"
            android:textSize="18sp"
            android:onClick="onHeaderSOSClick"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <!-- ── MESSAGE LIST ────────────────────────────────────────────────────── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatMessages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="64dp"
        android:layout_marginBottom="148dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:scrollbars="none"/>

    <!-- ── BOTTOM BAR ──────────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:elevation="10dp">

        <!-- Typing indicator -->
        <TextView
            android:id="@+id/tvChatTyping"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="4dp"
            android:text="🤖 ···"
            android:textColor="#7C6FFF"
            android:textSize="13sp"
            android:visibility="gone"/>

        <!-- Quick reply chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="8dp"
            android:paddingBottom="6dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupQuickReplies"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                android:visibility="gone"/>

        </HorizontalScrollView>

        <!-- Input row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#12122A"
            android:orientation="horizontal"
            android:padding="10dp"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/etChatInput"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chat_input"
                android:hint="Message Care Assistant..."
                android:textColor="#FFFFFF"
                android:textColorHint="#555577"
                android:textSize="15sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:imeOptions="actionSend"
                android:inputType="textMultiLine"
                android:maxLines="4"/>

            <ImageButton
                android:id="@+id/btnChatSend"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_send_btn"
                android:src="@android:drawable/ic_menu_send"
                android:tint="#FFFFFF"
                android:contentDescription="Send"/>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabChatVoice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:backgroundTint="#7C6FFF"
                app:srcCompat="@android:drawable/ic_btn_speak_now"
                app:maxImageSize="24dp"
                app:fabSize="mini"
                android:contentDescription="Voice"/>

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>