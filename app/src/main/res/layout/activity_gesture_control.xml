<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Camera preview fills screen -->
    <androidx.camera.view.PreviewView
        android:id="@+id/gesturePreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <!-- Flash overlay (shown when gesture detected) -->
    <View
        android:id="@+id/gestureFlashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#667C6FFF"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Top header bar -->
    <LinearLayout
        android:id="@+id/gestureHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#CC000000"
        android:padding="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="✋ Gesture Control"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnGestureClose"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Close"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:backgroundTint="#EF4444"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
    </LinearLayout>

    <!-- Gesture guide cards (middle of screen) -->
    <LinearLayout
        android:id="@+id/gestureGuide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/gestureHeader"
        app:layout_constraintBottom_toTopOf="@id/gestureStatusCard">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Show gesture to camera"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"/>

        <!-- 3 gesture hint cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="#CC2B0D0D"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✋" android:textSize="28sp"/>
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Raise Hand"
                    android:textColor="#EF4444"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="→ SOS"
                    android:textColor="#CCFFFFFF"
                    android:textSize="10sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="#CC0D1F2B"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👋" android:textSize="28sp"/>
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wave"
                    android:textColor="#0EA5E9"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="→ Call"
                    android:textColor="#CCFFFFFF"
                    android:textSize="10sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:background="#CC0D2B1E"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👈" android:textSize="28sp"/>
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Look Left"
                    android:textColor="#10B981"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="→ Location"
                    android:textColor="#CCFFFFFF"
                    android:textSize="10sp"/>
            </LinearLayout>

            <!-- 4th gesture card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="6dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="90dp"
                    android:layout_marginEnd="6dp"
                    android:background="#CC1A0D2B"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp">
                    <TextView android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👉" android:textSize="28sp"/>
                    <TextView android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Look Right"
                        android:textColor="#A855F7"
                        android:textSize="11sp"
                        android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="→ Safety Cam"
                        android:textColor="#CCFFFFFF"
                        android:textSize="10sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Gesture detected label (shown during countdown) -->
    <TextView
        android:id="@+id/tvGestureDetected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#CC7C6FFF"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Countdown text -->
    <TextView
        android:id="@+id/tvGestureCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="12dp"
        android:background="#CC000000"
        android:visibility="gone"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tvGestureDetected"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/gestureStatusCard"
        android:layout_marginTop="8dp"/>

    <!-- Status bar at bottom -->
    <LinearLayout
        android:id="@+id/gestureStatusCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#CC000000"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvGestureStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Starting camera..."
            android:textColor="#CCFFFFFF"
            android:textSize="13sp"
            android:gravity="center"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>