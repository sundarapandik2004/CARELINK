<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="80dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ══ HEADER ════════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="?attr/colorSurface"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="48dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  CARELINK  "
                    android:textSize="10sp"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold"
                    android:background="?attr/colorPrimaryContainer"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="10dp"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Caregiver Dashboard"
                    android:textSize="24sp"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvLinkedUser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loading..."
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="16dp"/>

                <!-- ★ YOUR CODE BOX — visible immediately, clear label, big copy button -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOUR CAREGIVER CODE"
                    android:textSize="10sp"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Share this code with the user during their registration"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="8dp"/>

                <!-- Code value — shown immediately in onCreate -->
                <TextView
                    android:id="@+id/tvMyCodeValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Loading your code..."
                    android:textSize="13sp"
                    android:textColor="?attr/colorOnSurface"
                    android:background="?android:attr/colorBackground"
                    android:padding="12dp"
                    android:fontFamily="monospace"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="8dp"/>

                <!-- Dedicated copy button — large and obvious -->
                <Button
                    android:id="@+id/btnCopyCode"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="📋  Copy Code to Share with User"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface"
                    android:backgroundTint="?attr/colorPrimary"
                    app:cornerRadius="10dp"/>

                <!-- Hidden tvMyCode kept for Java compatibility -->
                <TextView
                    android:id="@+id/tvMyCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="1sp"
                    android:visibility="gone"/>

            </LinearLayout>

            <!-- ══ SOS BANNER ════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1F0A0A"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:layout_marginTop="1dp">

                <TextView
                    android:id="@+id/tvSosStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No Active SOS"
                    android:textSize="18sp"
                    android:textColor="#10B981"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvSosTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="13sp"
                    android:textColor="?attr/colorOnSurface"
                    android:gravity="center"
                    android:visibility="gone"
                    android:layout_marginBottom="2dp"/>

                <TextView
                    android:id="@+id/tvSosLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="13sp"
                    android:textColor="?attr/colorOnSurface"
                    android:gravity="center"
                    android:visibility="gone"
                    android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnCallUser"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="Call User"
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnSurface"
                        android:backgroundTint="#10B981"
                        android:layout_marginEnd="6dp"
                        android:visibility="gone"
                        app:cornerRadius="10dp"/>

                    <Button
                        android:id="@+id/btnOpenMap"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="View Map"
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnSurface"
                        android:backgroundTint="#3B82F6"
                        android:layout_marginEnd="6dp"
                        android:visibility="gone"
                        app:cornerRadius="10dp"/>

                    <Button
                        android:id="@+id/btnResolveSOS"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="Resolve"
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnSurface"
                        android:backgroundTint="?attr/colorSurfaceVariant"
                        android:visibility="gone"
                        app:cornerRadius="10dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ══ AI RISK STATUS CARD ★ NEW ════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/riskStatusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#0D2B1E"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:layout_marginTop="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="USER STATUS"
                        android:textSize="10sp"
                        android:textColor="?attr/colorOnSurface"
                        android:alpha="0.5"
                        android:textStyle="bold"
                        android:letterSpacing="0.12"
                        android:layout_marginEnd="10dp"/>

                    <TextView
                        android:id="@+id/tvRiskLevel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LOW"
                        android:textSize="15sp"
                        android:textColor="#10B981"
                        android:textStyle="bold"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:background="#0D2B1E"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI Monitoring"
                        android:textSize="10sp"
                        android:textColor="?attr/colorPrimary"
                        android:background="?attr/colorPrimaryContainer"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRiskReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Monitoring active. Checking every 30 minutes."
                    android:textSize="13sp"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.7"
                    android:layout_marginBottom="10dp"/>

                <Button
                    android:id="@+id/btnCallFromRisk"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Call User Now"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#EF4444"
                    android:visibility="gone"
                    app:cornerRadius="10dp"/>

            </LinearLayout>

            <!-- ══ STATS ══════════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="20dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TODAY'S ACTIVITY"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurface"
                    android:letterSpacing="0.12"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="?attr/colorSurface"
                        android:layout_marginEnd="6dp">
                        <TextView
                            android:id="@+id/tvLastActive"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="12sp"
                            android:textColor="?attr/colorOnSurface"
                            android:gravity="center"
                            android:maxLines="2"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Last active"
                            android:textSize="10sp"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="#1F0A0A">
                        <TextView
                            android:id="@+id/tvStatSOS"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="28sp"
                            android:textColor="#10B981"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SOS alerts"
                            android:textSize="10sp"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="#0D2B1E"
                        android:layout_marginEnd="6dp">
                        <TextView
                            android:id="@+id/tvStatCompleted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="28sp"
                            android:textColor="#10B981"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Completed"
                            android:textSize="10sp"
                            android:textColor="#10B981"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="#2B0D0D"
                        android:layout_marginEnd="6dp">
                        <TextView
                            android:id="@+id/tvStatMissed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="28sp"
                            android:textColor="#EF4444"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Missed"
                            android:textSize="10sp"
                            android:textColor="#EF4444"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="#2B1E00">
                        <TextView
                            android:id="@+id/tvStatPending"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="28sp"
                            android:textColor="#F59E0B"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pending"
                            android:textSize="10sp"
                            android:textColor="#F59E0B"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ══ LAST COMMUNICATION ════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="?attr/colorSurface"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LAST COMMUNICATION"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurface"
                    android:letterSpacing="0.1"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvLastComm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No communication logged yet"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface"/>
            </LinearLayout>

            <!-- ══ REMINDERS LIST ════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="20dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="USER'S REMINDERS  (long-press to change status)"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurface"
                    android:letterSpacing="0.1"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:id="@+id/tvEmptyReminders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No reminders yet"
                    android:textSize="14sp"
                    android:textColor="#374151"
                    android:gravity="center"
                    android:padding="24dp"
                    android:visibility="gone"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvReminders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>

            </LinearLayout>


            <!-- Evidence Card shown after SOS triggered -->
            <LinearLayout
                android:id="@+id/evidenceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1A0D0D"
                android:padding="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚨 SOS Evidence"
                    android:textColor="#EF4444"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvEvidenceTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Captured: --"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvEvidenceLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Location: --"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvEvidenceAudio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Audio: waiting..."
                    android:textColor="#6B7280"
                    android:textSize="13sp"
                    android:layout_marginBottom="10dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📸 Photos"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp"/>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/evidencePhotoRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="4dp"/>

                </HorizontalScrollView>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddReminder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:src="@android:drawable/ic_input_add"
        android:contentDescription="Add reminder for user"
        app:backgroundTint="?attr/colorPrimary"
        app:tint="?attr/colorOnPrimary"
        app:elevation="6dp"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>