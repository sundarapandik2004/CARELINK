<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:paddingTop="52dp"
        android:paddingBottom="40dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Account"
            android:textSize="30sp"
            android:textColor="?attr/colorOnBackground"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose your role and fill in your details"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.5"
            android:layout_marginBottom="32dp"/>

        <!-- ══ ROLE SELECTION ══════════════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WHO ARE YOU?"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.5"
            android:letterSpacing="0.12"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <!--
            ★ FIX: RadioButtons are now DIRECT children of RadioGroup.
            Previously they were wrapped in LinearLayouts which made RadioGroup
            unable to manage them — both appeared selected simultaneously.

            To keep the card-style look, we use a custom background on each
            RadioButton instead of wrapping them.
        -->
        <RadioGroup
            android:id="@+id/rgRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <!-- USER role button — direct child, RadioGroup can now control it -->
            <RadioButton
                android:id="@+id/rbUser"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="👤  User"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:textStyle="bold"
                android:buttonTint="?attr/colorPrimary"
                android:background="?attr/colorSurface"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:gravity="center_vertical"
                android:checked="true"/>

            <!-- CAREGIVER role button — direct child, RadioGroup can now control it -->
            <RadioButton
                android:id="@+id/rbCaregiver"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="👨‍⚕️  Caregiver"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:textStyle="bold"
                android:buttonTint="?attr/colorPrimary"
                android:background="?attr/colorSurface"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:gravity="center_vertical"
                android:checked="false"/>

        </RadioGroup>

        <!-- Role description shown below the buttons -->
        <TextView
            android:id="@+id/tvRoleDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Person using the app for reminders, communication and SOS"
            android:textSize="12sp"
            android:textColor="?attr/colorPrimary"
            android:background="?attr/colorPrimaryContainer"
            android:padding="12dp"
            android:layout_marginBottom="24dp"/>

        <!-- ══ FULL NAME ══════════════════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FULL NAME"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.5"
            android:letterSpacing="0.1"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="e.g. John Doe"
            android:textSize="16sp"
            android:padding="14dp"
            android:background="?attr/colorSurface"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurface"
            android:inputType="textPersonName"
            android:layout_marginBottom="14dp"/>

        <!-- ══ EMAIL ══════════════════════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EMAIL"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.5"
            android:letterSpacing="0.1"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="you@example.com"
            android:textSize="16sp"
            android:padding="14dp"
            android:background="?attr/colorSurface"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurface"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="14dp"/>

        <!-- ══ PASSWORD ═══════════════════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PASSWORD"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.5"
            android:letterSpacing="0.1"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="Minimum 6 characters"
            android:textSize="16sp"
            android:padding="14dp"
            android:background="?attr/colorSurface"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurface"
            android:inputType="textPassword"
            android:layout_marginBottom="20dp"/>

        <!-- ══ CAREGIVER CODE (only shown for User role) ══════════════════ -->
        <TextView
            android:id="@+id/tvCaregiverCodeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CAREGIVER CODE  (optional)"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.5"
            android:letterSpacing="0.1"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"
            android:visibility="visible"/>

        <EditText
            android:id="@+id/etCaregiverCode"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="Paste your caregiver's code here"
            android:textSize="15sp"
            android:padding="14dp"
            android:background="?attr/colorSurface"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurface"
            android:inputType="textNoSuggestions"
            android:fontFamily="monospace"
            android:layout_marginBottom="6dp"
            android:visibility="visible"/>

        <TextView
            android:id="@+id/tvCaregiverHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your caregiver registers first, shares their code from the Caregiver Dashboard. You can also skip this and add it later in Settings."
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.4"
            android:layout_marginBottom="28dp"
            android:visibility="visible"/>

        <!-- Progress -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_gravity="center"
            android:layout_marginBottom="12dp"/>

        <!-- Register button -->
        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Create Account"
            android:textSize="17sp"
            android:textColor="?attr/colorOnPrimary"
            android:textStyle="bold"
            android:backgroundTint="?attr/colorPrimary"
            android:layout_marginBottom="14dp"
            app:cornerRadius="14dp"/>

        <!-- Go to login -->
        <Button
            android:id="@+id/btnGoLogin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Already have an account? Sign In"
            android:textSize="14sp"
            android:textColor="?attr/colorPrimary"
            android:backgroundTint="?attr/colorPrimaryContainer"
            app:cornerRadius="14dp"/>

    </LinearLayout>
</ScrollView>